page {
  min-height: 100vh;
  background: #f5f6fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.page-with-tab {
  padding-bottom: 128rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(235, 238, 245, 0.96);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(31, 41, 55, 0.075);
}

.soft-card {
  box-sizing: border-box;
  border: 1rpx solid #eef1f7;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(31, 41, 55, 0.045);
}

.section-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.muted {
  color: #8a94a6;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #fff3e9;
  color: #d97706;
  font-size: 22rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f3f4ff;
  color: #6b4cff;
  font-size: 22rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7c4dff 0%, #5c3df5 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 32rpx rgba(92, 61, 245, 0.28);
}

.search {
  display: flex;
  align-items: center;
  height: 62rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f1f3f8;
  color: #a0a8b8;
  font-size: 24rpx;
}

.bottle {
  position: relative;
  width: 74rpx;
  height: 142rpx;
  border-radius: 18rpx 18rpx 14rpx 14rpx;
  background: linear-gradient(180deg, #f6b23a 0%, #e57622 100%);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.42), 0 12rpx 24rpx rgba(181, 92, 18, 0.18);
}

.bottle::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: -34rpx;
  width: 30rpx;
  height: 46rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #f5c15c 0%, #db7f24 100%);
}

.bottle::after {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
}

.bottle.green {
  background: linear-gradient(180deg, #60d394 0%, #168b59 100%);
}

.bottle.red {
  background: linear-gradient(180deg, #ff786f 0%, #c83737 100%);
}

.bottle.dark {
  background: linear-gradient(180deg, #3c424d 0%, #111827 100%);
}

.bottle.clear {
  background: linear-gradient(180deg, #f8f9ff 0%, #f6bd41 100%);
}
