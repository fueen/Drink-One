page {
  min-height: 100vh;
  background: #eef3ff;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  font-weight: 600;
}

view,
text,
input,
textarea,
button {
  font-weight: 600;
}

:root {
  --color-bg: #F8F9FB;
  --color-card: rgba(255,255,255,0.72);
  --color-primary: #FFB85C;
  --color-secondary: #7A73FF;
  --color-success: #2ED573;
  --color-warning: #FFA502;
  --color-text-primary: #1C1C1E;
  --color-text-secondary: #6B7280;
  --color-divider: rgba(0,0,0,0.06);
  --radius-small: 16px;
  --radius-medium: 24px;
  --radius-large: 32px;
  --radius-pill: 999px;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 48rpx;
  background:
    radial-gradient(circle at 18% 6%, rgba(119, 107, 255, 0.12), transparent 34%),
    radial-gradient(circle at 86% 12%, rgba(255, 184, 92, 0.12), transparent 32%),
    linear-gradient(180deg, #f7faff 0%, #f4f6fb 48%, #ffffff 100%);
}

.safe-area {
  height: 32rpx;
}

.page-header {
  padding: 24rpx 0 16rpx;
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.page-with-tab {
  padding-bottom: 136rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  flex-shrink: 0;
}

.top-title {
  flex: 1;
  text-align: center;
  color: #05060a;
  font-size: 30rpx;
  font-weight: 900;
}

.nav-action,
.nav-back {
  min-width: 58rpx;
  color: #05060a;
  font-size: 30rpx;
  font-weight: 800;
}

.nav-action {
  text-align: right;
  color: #6C5CFF;
  font-size: 24rpx;
}

.app-shell {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 58rpx rgba(87, 98, 128, 0.08);
  backdrop-filter: blur(24px);
}

.soft-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(24px);
}

.glass-card {
  box-sizing: border-box;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  background: rgba(255,255,255,0.72);
  box-shadow: 0 18rpx 58rpx rgba(87, 98, 128, 0.08);
  backdrop-filter: blur(24px);
}

.section-title {
  display: block;
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 42rpx;
  word-break: break-word;
}

.muted {
  color: #8a94a6;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 184, 92, 0.16);
  color: #b96d18;
  font-size: 26rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(122, 115, 255, 0.12);
  color: #7A73FF;
  font-size: 22rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 128rpx;
  border-radius: 64rpx;
  background: linear-gradient(135deg, #69A7FF 0%, #7C66FF 46%, #D96BFF 100%);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 20rpx 42rpx rgba(112, 101, 255, 0.32);
}

.search {
  display: flex;
  align-items: center;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  color: #9aa3b5;
  font-size: 24rpx;
}

.bottle {
  position: relative;
  width: 74rpx;
  height: 142rpx;
  border-radius: 18rpx 18rpx 14rpx 14rpx;
  background: linear-gradient(180deg, #f6b23a 0%, #e57622 100%);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.42), 0 12rpx 24rpx rgba(181, 92, 18, 0.18);
}

.bottle::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: -34rpx;
  width: 30rpx;
  height: 46rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #f5c15c 0%, #db7f24 100%);
}

.bottle::after {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
}

.bottle.green {
  background: linear-gradient(180deg, #60d394 0%, #168b59 100%);
}

.bottle.red {
  background: linear-gradient(180deg, #ff786f 0%, #c83737 100%);
}

.bottle.dark {
  background: linear-gradient(180deg, #3c424d 0%, #111827 100%);
}

.bottle.clear {
  background: linear-gradient(180deg, #f8f9ff 0%, #f6bd41 100%);
}

.tap-scale {
  transition: transform 200ms ease-out, box-shadow 300ms ease-out;
}

.pressing {
  transform: scale(0.96) translateY(-4rpx);
}

.sr-only {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

/* UI V3 primitives based on the latest 3.png reference. */
:root {
  --v3-bg: #f7f8fb;
  --v3-card: #ffffff;
  --v3-text: #111318;
  --v3-muted: #8d95a3;
  --v3-line: #edf0f5;
  --v3-orange: #ff9f45;
  --v3-pink: #ff4f7b;
  --v3-purple: #7a64ff;
  --v3-gradient: linear-gradient(135deg, #ff9f45 0%, #ff4f7b 100%);
  --v3-shadow: 0 18rpx 54rpx rgba(34, 42, 64, 0.08);
  --v3-soft-shadow: 0 10rpx 30rpx rgba(34, 42, 64, 0.06);
}

.v3-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 22rpx 32rpx 52rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
  color: var(--v3-text);
}

.v3-page.page-with-tab {
  padding-bottom: 144rpx;
}

.v3-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(236, 239, 245, 0.88);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--v3-soft-shadow);
}

.v3-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
}

.v3-title {
  display: block;
  color: var(--v3-text);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
}

.v3-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--v3-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.v3-section-title {
  display: block;
  color: var(--v3-text);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.v3-more {
  color: #a3a9b5;
  font-size: 21rpx;
  font-weight: 800;
}

.v3-gradient-button,
.v3-fixed-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--v3-gradient);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
  box-shadow: 0 16rpx 34rpx rgba(255, 79, 123, 0.25);
}

.v3-fixed-action {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.v3-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: var(--v3-text);
  font-size: 30rpx;
  font-weight: 900;
}

.v3-icon-button.hot {
  color: #ff315d;
}

.v3-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff3e8;
  color: #e97818;
  font-size: 20rpx;
  font-weight: 900;
}

.v3-search {
  display: flex;
  align-items: center;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 999rpx;
  background: #f9fafc;
  color: #a7adba;
  font-size: 22rpx;
}

.v3-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

.v3-topbar-title {
  flex: 1;
  color: var(--v3-text);
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
}

.v3-back {
  width: 56rpx;
  color: var(--v3-text);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.v3-muted-text {
  color: var(--v3-muted);
}
