page {
  min-height: 100vh;
  background: #eef3ff;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  font-weight: 600;
}

view,
text,
input,
textarea,
button {
  font-weight: 600;
}

:root {
  --color-bg: #F8F9FB;
  --color-card: rgba(255,255,255,0.72);
  --color-primary: #FFB85C;
  --color-secondary: #7A73FF;
  --color-success: #2ED573;
  --color-warning: #FFA502;
  --color-text-primary: #1C1C1E;
  --color-text-secondary: #6B7280;
  --color-divider: rgba(0,0,0,0.06);
  --radius-small: 16px;
  --radius-medium: 24px;
  --radius-large: 32px;
  --radius-pill: 999px;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 48rpx;
  background:
    radial-gradient(circle at 18% 6%, rgba(119, 107, 255, 0.12), transparent 34%),
    radial-gradient(circle at 86% 12%, rgba(255, 184, 92, 0.12), transparent 32%),
    linear-gradient(180deg, #f7faff 0%, #f4f6fb 48%, #ffffff 100%);
}

.safe-area {
  height: 32rpx;
}

.page-header {
  padding: 24rpx 0 16rpx;
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.page-with-tab {
  padding-bottom: 56rpx;
}

.mock-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  color: #05060a;
  font-size: 24rpx;
  font-weight: 800;
}

.status-icons {
  letter-spacing: 2rpx;
  font-size: 22rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

.top-title {
  flex: 1;
  text-align: center;
  color: #05060a;
  font-size: 30rpx;
  font-weight: 900;
}

.nav-action,
.nav-back {
  min-width: 58rpx;
  color: #05060a;
  font-size: 30rpx;
  font-weight: 800;
}

.nav-action {
  text-align: right;
  color: #6C5CFF;
  font-size: 24rpx;
}

.app-shell {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 58rpx rgba(87, 98, 128, 0.08);
  backdrop-filter: blur(24px);
}

.soft-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(24px);
}

.glass-card {
  box-sizing: border-box;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  background: rgba(255,255,255,0.72);
  box-shadow: 0 18rpx 58rpx rgba(87, 98, 128, 0.08);
  backdrop-filter: blur(24px);
}

.section-title {
  display: block;
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.muted {
  color: #8a94a6;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 184, 92, 0.16);
  color: #b96d18;
  font-size: 26rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(122, 115, 255, 0.12);
  color: #7A73FF;
  font-size: 22rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 128rpx;
  border-radius: 64rpx;
  background: linear-gradient(135deg, #69A7FF 0%, #7C66FF 46%, #D96BFF 100%);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 20rpx 42rpx rgba(112, 101, 255, 0.32);
}

.search {
  display: flex;
  align-items: center;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  color: #9aa3b5;
  font-size: 24rpx;
}

.bottle {
  position: relative;
  width: 74rpx;
  height: 142rpx;
  border-radius: 18rpx 18rpx 14rpx 14rpx;
  background: linear-gradient(180deg, #f6b23a 0%, #e57622 100%);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.42), 0 12rpx 24rpx rgba(181, 92, 18, 0.18);
}

.bottle::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: -34rpx;
  width: 30rpx;
  height: 46rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #f5c15c 0%, #db7f24 100%);
}

.bottle::after {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
}

.bottle.green {
  background: linear-gradient(180deg, #60d394 0%, #168b59 100%);
}

.bottle.red {
  background: linear-gradient(180deg, #ff786f 0%, #c83737 100%);
}

.bottle.dark {
  background: linear-gradient(180deg, #3c424d 0%, #111827 100%);
}

.bottle.clear {
  background: linear-gradient(180deg, #f8f9ff 0%, #f6bd41 100%);
}
