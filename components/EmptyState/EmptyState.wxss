.empty-state {
  box-sizing: border-box;
  padding: 56rpx 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
}

.empty-icon,
.empty-title,
.empty-desc {
  display: block;
}

.empty-icon {
  color: #FFB85C;
  font-size: 58rpx;
}

.empty-title {
  margin-top: 14rpx;
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
}
