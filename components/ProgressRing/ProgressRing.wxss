.progress-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: conic-gradient(#FFB85C 0deg, #FF9966 168deg, rgba(0, 0, 0, 0.06) 168deg);
}

.ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
}

.ring-value {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 700;
}

.ring-label {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 18rpx;
}
