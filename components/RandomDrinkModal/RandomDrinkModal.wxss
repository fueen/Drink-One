.random-modal {
  position: fixed;
  inset: 0;
  z-index: 99;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(13, 16, 22, 0.76);
  backdrop-filter: blur(18px);
}

.modal-panel {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 138rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx 32rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 34rpx 90rpx rgba(0, 0, 0, 0.28);
  animation: modalIn 300ms ease-out both;
}

.modal-handle {
  width: 62rpx;
  height: 7rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d4d7df;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-top {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  min-height: 42rpx;
}

.modal-title {
  color: #12141b;
  font-size: 30rpx;
  font-weight: 900;
}

.spark {
  color: #ffb22e;
  font-size: 20rpx;
}

.modal-close {
  position: absolute;
  right: -2rpx;
  top: -4rpx;
  color: #12141b;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
}

.drawing-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 560rpx;
  box-sizing: border-box;
  padding: 68rpx 20rpx 34rpx;
}

.draw-orbit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: conic-gradient(from 120deg, #ff9f45, #ff4f7b, #7a64ff, #ff9f45);
  box-shadow: 0 20rpx 50rpx rgba(255, 79, 123, 0.22);
  animation: drawSpin 1100ms linear infinite;
}

.draw-glass {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #ff8a42;
  font-size: 46rpx;
}

@keyframes drawSpin {
  to {
    transform: rotate(360deg);
  }
}

.drawing-title,
.drawing-desc,
.progress-text,
.modal-name,
.modal-en,
.modal-abv,
.modal-desc,
.modal-score text {
  display: block;
}

.drawing-title {
  margin-top: 38rpx;
  color: #12141b;
  font-size: 34rpx;
  font-weight: 900;
}

.drawing-desc {
  margin-top: 12rpx;
  color: #8d95a3;
  font-size: 23rpx;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 40rpx;
  border-radius: 999rpx;
  background: #ffe9de;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff9f45, #ff4f7b);
  transition: width 180ms ease-out;
}

.progress-text {
  margin-top: 14rpx;
  color: #ff6a55;
  font-size: 23rpx;
  font-weight: 900;
}

.modal-bottle {
  display: block;
  width: 220rpx;
  height: 262rpx;
  margin: 20rpx auto 10rpx;
  filter: drop-shadow(0 24rpx 28rpx rgba(151, 78, 13, 0.2));
}

.modal-card {
  box-sizing: border-box;
  padding: 26rpx 0 0;
  background: transparent;
}

.modal-copy {
  min-width: 0;
}

.modal-name {
  color: #12141b;
  font-size: 34rpx;
  font-weight: 900;
}

.modal-en,
.modal-abv,
.modal-desc {
  margin-top: 8rpx;
  color: #7c8492;
  font-size: 22rpx;
}

.modal-score {
  min-width: 90rpx;
  color: #12141b;
  text-align: right;
  font-size: 28rpx;
  font-weight: 900;
}

.stars {
  color: #ffb22e;
  font-size: 17rpx;
}

.modal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff2e6;
  color: #e97818;
  font-size: 20rpx;
}

.modal-desc {
  line-height: 1.6;
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.detail-button,
.again-button {
  height: 76rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.detail-button {
  background: #ffffff;
  color: #12141b;
  box-shadow: 0 10rpx 28rpx rgba(39, 48, 69, 0.08);
}

.again-button {
  background: linear-gradient(135deg, #ff9f45 0%, #ff4f7b 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(255, 79, 123, 0.24);
}
