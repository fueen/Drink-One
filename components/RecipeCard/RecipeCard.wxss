.recipe-card {
  min-height: 320rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(24px);
}

.recipe-cover {
  display: block;
  width: 100%;
  height: 200rpx;
}

.recipe-body {
  padding: 20rpx;
}

.recipe-name,
.recipe-meta {
  display: block;
}

.recipe-name {
  color: #1C1C1E;
  font-size: 28rpx;
  font-weight: 600;
}

.recipe-meta {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
}
