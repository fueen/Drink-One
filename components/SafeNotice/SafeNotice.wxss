.safe-notice {
  display: flex;
  gap: 18rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 184, 92, 0.32);
  border-radius: 24rpx;
  background: rgba(255, 248, 236, 0.82);
}

.safe-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFB85C;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.safe-title,
.safe-content {
  display: block;
}

.safe-title {
  color: #b96d18;
  font-size: 26rpx;
  font-weight: 700;
}

.safe-content {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.45;
}
