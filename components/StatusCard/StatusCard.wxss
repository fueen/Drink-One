.status-card {
  width: 340rpx;
  height: 240rpx;
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(24px);
}

.status-icon,
.status-name,
.status-desc {
  display: block;
}

.status-icon {
  font-size: 80rpx;
}

.status-name {
  margin-top: 18rpx;
  color: #1C1C1E;
  font-size: 40rpx;
  font-weight: 600;
}

.status-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 26rpx;
}
