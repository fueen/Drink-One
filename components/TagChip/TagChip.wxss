.tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 184, 92, 0.16);
  color: #b96d18;
  font-size: 26rpx;
  font-weight: 500;
}

.active {
  background: linear-gradient(180deg, #FFB85C 0%, #FF9966 100%);
  color: #ffffff;
}
