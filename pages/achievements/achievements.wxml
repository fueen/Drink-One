<view class="v3-page page-with-tab v3-achievements achievements-page">
  <view class="v3-topbar">
    <text class="v3-topbar-title align-left">成就</text>
    <text class="v3-icon-button"></text>
  </view>

  <view class="achievement-summary-card">
    <view class="summary-copy">
      <text class="summary-label">已解锁成就</text>
      <text class="summary-count">32 / 68</text>
    </view>
    <view class="summary-cup">🏆</view>
    <progress-ring value="{{unlocked}}" total="{{achievements.length}}"></progress-ring>
  </view>

  <text class="v3-section-title unlock-title">最近解锁</text>
  <view class="recent-list">
    <view class="recent-row" wx:for="{{recentAchievements}}" wx:key="name">
      <text class="recent-medal">🏅</text>
      <view class="recent-copy">
        <text class="recent-name">{{item.name}}</text>
        <text class="recent-desc">{{item.desc}}</text>
      </view>
      <text class="recent-date">{{index === 0 ? '2024.06.10' : '2024.06.08'}}</text>
    </view>
  </view>

  <view class="v3-section-head wall-head">
    <text class="v3-section-title">成就墙</text>
    <text class="v3-more">全部⌄</text>
  </view>
  <view class="achievement-grid">
    <view class="achievement-card {{item.active ? 'active' : ''}}" wx:for="{{achievements}}" wx:key="name">
      <text class="medal">{{item.active ? '★' : '◇'}}</text>
      <text class="ach-name">{{item.name}}</text>
      <text class="ach-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
