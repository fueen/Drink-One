.hero-progress {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 144rpx;
  background: linear-gradient(135deg, #7C66FF 0%, #78A7FF 58%, #F7C77A 100%);
  color: #ffffff;
  overflow: hidden;
}

.align-left {
  text-align: left;
}

.page-title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.unlock-title {
  margin-top: 30rpx;
}

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 28rpx;
}

.achievement-card {
  min-height: 146rpx;
  box-sizing: border-box;
  padding: 28rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
  opacity: 0.62;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(24px);
}

.achievement-card.active {
  border-color: #f6bd41;
  background: rgba(255, 250, 241, 0.86);
  opacity: 1;
}

.medal {
  display: block;
  color: #f59e0b;
  font-size: 54rpx;
}

.ach-name {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.ach-desc {
  display: block;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 18rpx;
}

.progress-card {
  margin-top: 28rpx;
  padding: 26rpx;
}

.progress-line {
  margin-top: 20rpx;
}

.count {
  font-size: 40rpx;
  font-weight: 900;
}

.track {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #e9e7ff;
}

.bar {
  width: 76%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #FFB85C, #FF9966);
}
