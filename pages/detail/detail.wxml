<view class="page detail-page">
  <view class="mock-status"><text>9:41</text><text class="status-icons">▮▮▮ ᯤ ▰</text></view>
  <view class="top-bar">
    <text class="nav-back">‹</text>
    <text class="top-title"></text>
    <text class="nav-action">♡　⇧</text>
  </view>

  <view class="bottle-stage">
    <text class="hot-badge">人气推荐</text>
    <image class="big-bottle" src="{{drink.image}}" mode="aspectFit"></image>
  </view>

  <view class="glass-card info-panel">
    <view class="between">
      <view>
        <text class="drink-title">{{drink.name}}</text>
        <text class="drink-en">{{drink.englishName}}</text>
        <text class="drink-meta">{{drink.abv}}%vol　·　日本　·　700ml</text>
      </view>
      <view class="score-card">
        <text class="score">4.6</text>
        <text class="score-desc">2363人评分</text>
      </view>
    </view>
    <view class="detail-tags">
      <text class="tag" wx:for="{{drink.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="intro">
      <text class="intro-title">酒品简介</text>
      <text class="intro-text">经典角瓶威士忌，口感柔和，带有香草与蜂蜜的韵味，适合入门品鉴。</text>
    </view>
  </view>

  <view class="action-grid">
    <view class="glass-card action-card" bindtap="goRecord">
      <text class="action-icon">✎</text>
      <view>
        <text class="action-title">记录品鉴</text>
        <text class="action-desc">写下此刻感受</text>
      </view>
    </view>
    <view class="glass-card action-card" bindtap="toggleFavorite">
      <text class="action-icon">☆</text>
      <view>
        <text class="action-title">加入收藏</text>
        <text class="action-desc">收藏到酒单</text>
      </view>
    </view>
  </view>
</view>
