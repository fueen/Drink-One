<view class="page detail-page">
  <view class="top-bar">
    <text class="nav-back" bindtap="goBack">‹</text>
    <text class="top-title"></text>
    <text class="nav-action">♡　⇧</text>
  </view>

  <view class="bottle-stage">
    <text class="hot-badge">人气推荐</text>
    <image class="big-bottle" src="{{drink.image}}" mode="aspectFit"></image>
  </view>

  <view class="glass-card info-panel">
    <view class="between info-head">
      <view class="info-copy">
        <text class="drink-title">{{drink.name}}</text>
        <text class="drink-en">{{drink.englishName}}</text>
      </view>
      <view class="abv-box">
        <text class="abv-value">{{drink.abv}}</text>
        <text class="abv-label">酒精度</text>
      </view>
    </view>
    <view class="basic-tags">
      <text class="mini-chip" wx:for="{{drink.basicTags}}" wx:key="*this">{{item}}</text>
    </view>
    <text class="intro-text">酒品简介：{{drink.description}}</text>
    <view class="detail-tags">
      <text class="tag" wx:for="{{drink.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="glass-card scene-panel">
    <text class="panel-title">适合场景</text>
    <view class="scene-grid">
      <view class="scene-item" wx:for="{{drink.scenes}}" wx:key="*this">
        <text class="scene-icon">{{index === 0 ? '♙' : index === 1 ? '♧' : index === 2 ? '✦' : '□'}}</text>
        <text class="scene-name">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="risk-warning">
    <text>风险提示：本应用仅提供酒类信息展示，饮酒有风险，请理性饮酒。</text>
  </view>

  <view class="detail-actions">
    <button class="record-button" bindtap="goRecord">✎ 记录品鉴</button>
    <button class="favorite-button" bindtap="toggleFavorite">♥ 加入收藏</button>
  </view>
</view>
