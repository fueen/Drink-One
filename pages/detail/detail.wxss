.detail-page {
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 184, 92, 0.18), transparent 32%),
    linear-gradient(180deg, #fbfcff 0%, #f4f6fb 60%, #ffffff 100%);
}

.bottle-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 410rpx;
  margin-top: 8rpx;
  border-radius: 0 0 48% 48%;
  background: radial-gradient(ellipse at 50% 92%, rgba(143, 130, 255, 0.14), transparent 58%);
}

.hot-badge {
  position: absolute;
  left: 10rpx;
  top: 40rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 184, 92, 0.15);
  color: #f2781f;
  font-size: 22rpx;
  font-weight: 900;
}

.big-bottle {
  width: 270rpx;
  height: 350rpx;
  filter: drop-shadow(0 28rpx 38rpx rgba(174, 94, 12, 0.24));
}

.info-panel {
  margin-top: -22rpx;
  padding: 32rpx;
  border-radius: 34rpx;
}

.drink-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.drink-en {
  display: block;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.drink-meta,
.score,
.score-desc,
.intro-title,
.intro-text,
.action-title,
.action-desc {
  display: block;
}

.drink-meta {
  margin-top: 10rpx;
  color: #6C5CFF;
  font-size: 22rpx;
}

.score-card {
  min-width: 116rpx;
  padding: 18rpx 8rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
}

.score {
  color: #1C1C1E;
  font-size: 34rpx;
  font-weight: 900;
}

.score-desc {
  margin-top: 6rpx;
  color: #9aa3b5;
  font-size: 18rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.intro {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(248, 250, 255, 0.8);
}

.intro-title {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
}

.intro-text {
  margin-top: 10rpx;
  color: #697386;
  font-size: 22rpx;
  line-height: 1.55;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
}

.action-icon {
  color: #168CFF;
  font-size: 38rpx;
}

.action-title {
  color: #1C1C1E;
  font-size: 25rpx;
  font-weight: 900;
}

.action-desc {
  margin-top: 4rpx;
  color: #9aa3b5;
  font-size: 20rpx;
}
