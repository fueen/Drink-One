.detail-page {
  padding-bottom: 176rpx;
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 184, 92, 0.16), transparent 30%),
    radial-gradient(circle at 76% 32%, rgba(122, 115, 255, 0.16), transparent 34%),
    linear-gradient(180deg, #fbfcff 0%, #f6f8fd 58%, #ffffff 100%);
}

.bottle-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 390rpx;
  background: radial-gradient(ellipse at 50% 86%, rgba(122, 115, 255, 0.16), transparent 56%);
}

.hot-badge {
  position: absolute;
  left: 6rpx;
  top: 34rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 184, 92, 0.15);
  color: #F2781F;
  font-size: 22rpx;
  font-weight: 900;
}

.big-bottle {
  width: 250rpx;
  height: 342rpx;
  filter: drop-shadow(0 30rpx 34rpx rgba(149, 80, 13, 0.24));
}

.info-panel {
  margin-top: -20rpx;
  padding: 32rpx;
  border-radius: 34rpx;
}

.info-head {
  align-items: flex-start;
}

.info-copy {
  flex: 1;
  min-width: 0;
}

.drink-title,
.drink-en,
.intro-text,
.panel-title,
.scene-name,
.risk-warning text,
.abv-value,
.abv-label {
  display: block;
}

.drink-title {
  color: #1C1C1E;
  font-size: 34rpx;
  font-weight: 900;
}

.drink-en {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
}

.abv-box {
  min-width: 104rpx;
  text-align: right;
}

.abv-value {
  color: #1C1C1E;
  font-size: 28rpx;
  font-weight: 900;
}

.abv-label {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 19rpx;
}

.basic-tags,
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.basic-tags {
  margin-top: 18rpx;
}

.mini-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(122, 115, 255, 0.1);
  color: #7A73FF;
  font-size: 20rpx;
}

.intro-text {
  margin-top: 22rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.65;
}

.detail-tags {
  margin-top: 20rpx;
}

.scene-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.panel-title {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.scene-item {
  text-align: center;
}

.scene-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 8rpx;
  border-radius: 20rpx;
  background: rgba(122, 115, 255, 0.1);
  color: #7A73FF;
  font-size: 28rpx;
}

.scene-name {
  color: #6B7280;
  font-size: 20rpx;
}

.risk-warning {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 184, 92, 0.12);
}

.risk-warning text {
  color: #A15C12;
  font-size: 22rpx;
  line-height: 1.5;
}

.detail-actions {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 18rpx;
}

.record-button,
.favorite-button {
  height: 82rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.record-button {
  background: rgba(255, 255, 255, 0.88);
  color: #7A73FF;
  box-shadow: 0 18rpx 44rpx rgba(87, 98, 128, 0.08);
}

.favorite-button {
  background: linear-gradient(135deg, #7A73FF, #8C6BFF);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(122, 115, 255, 0.28);
}
