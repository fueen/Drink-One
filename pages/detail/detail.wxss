.detail-page {
  padding-bottom: 168rpx;
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 174, 83, 0.18), transparent 32%),
    linear-gradient(180deg, #fffaf4 0%, #ffffff 46%, #f8f9fc 100%);
}

.detail-icons {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.bottle-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 394rpx;
}

.hot-badge {
  position: absolute;
  left: 0;
  top: 34rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1e1;
  color: #e97818;
  font-size: 20rpx;
  font-weight: 900;
}

.big-bottle {
  width: 216rpx;
  height: 330rpx;
  filter: drop-shadow(0 32rpx 34rpx rgba(122, 64, 13, 0.22));
}

.info-panel {
  padding: 28rpx;
  border-radius: 28rpx;
}

.info-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.info-copy {
  flex: 1;
  min-width: 0;
}

.drink-title,
.drink-en,
.rating-score,
.rating-stars,
.rating-count,
.metric-value,
.metric-label,
.intro-title,
.intro-text,
.scene-name {
  display: block;
}

.drink-title {
  color: #111318;
  font-size: 34rpx;
  font-weight: 900;
}

.drink-en {
  margin-top: 6rpx;
  color: #7f8794;
  font-size: 22rpx;
}

.rating-block {
  min-width: 120rpx;
  text-align: right;
}

.rating-score {
  color: #111318;
  font-size: 28rpx;
  font-weight: 900;
}

.rating-stars {
  margin-top: 2rpx;
  color: #ffbd2e;
  font-size: 18rpx;
}

.rating-count {
  margin-top: 2rpx;
  color: #a1a8b4;
  font-size: 18rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 26rpx;
}

.metric {
  text-align: center;
}

.metric-value {
  color: #111318;
  font-size: 23rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 6rpx;
  color: #8d95a3;
  font-size: 19rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 26rpx;
}

.intro-title {
  margin-top: 24rpx;
  color: #111318;
  font-size: 24rpx;
  font-weight: 900;
}

.intro-text {
  margin-top: 10rpx;
  color: #727b8a;
  font-size: 23rpx;
  line-height: 1.7;
}

.scene-panel {
  margin-top: 26rpx;
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.scene-item {
  text-align: center;
}

.scene-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto 8rpx;
  border-radius: 18rpx;
  background: #f3f0ff;
  color: #7a64ff;
  font-size: 26rpx;
}

.scene-name {
  color: #7f8794;
  font-size: 19rpx;
}

.detail-actions {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1.18fr;
  gap: 18rpx;
  z-index: 20;
}

.record-button,
.favorite-button {
  height: 82rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.record-button {
  background: #ffffff;
  color: #111318;
  box-shadow: 0 12rpx 30rpx rgba(39, 48, 69, 0.08);
}

.favorite-button {
  background: linear-gradient(135deg, #ff9f45 0%, #ff4f7b 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(255, 79, 123, 0.24);
}
