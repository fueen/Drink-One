.diy-page {
  padding-bottom: 158rpx;
  background:
    radial-gradient(circle at 18% 8%, rgba(122, 115, 255, 0.14), transparent 34%),
    linear-gradient(180deg, #fbfcff 0%, #f6f8fc 100%);
}

.step-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 0 34rpx;
  overflow: hidden;
}

.recipe-list-panel {
  margin-top: 26rpx;
}

.my-recipe-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.my-recipe-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 46rpx rgba(87, 98, 128, 0.08);
}

.my-recipe-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  background: #eef3ff;
}

.my-recipe-copy {
  flex: 1;
  min-width: 0;
}

.my-recipe-name,
.my-recipe-desc,
.my-recipe-meta {
  display: block;
}

.my-recipe-name {
  color: #1C1C1E;
  font-size: 28rpx;
  font-weight: 900;
}

.my-recipe-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.45;
}

.my-recipe-meta {
  margin-top: 10rpx;
  color: #FF6F73;
  font-size: 21rpx;
}

.step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  color: #B0B6C4;
  font-size: 20rpx;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #E5E8F0;
  color: #ffffff;
  font-size: 20rpx;
}

.step.active .step-dot {
  background: linear-gradient(135deg, #7A73FF, #8C6BFF);
  box-shadow: 0 10rpx 24rpx rgba(122, 115, 255, 0.25);
}

.step.active .step-text {
  color: #1C1C1E;
}

.step-text {
  max-width: 72rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wizard-panel,
.wizard-card {
  margin-top: 8rpx;
}

.base-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.base-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 204rpx;
  box-sizing: border-box;
  padding: 16rpx 8rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 16rpx 42rpx rgba(87, 98, 128, 0.08);
}

.base-card.selected {
  border-color: #7A73FF;
  color: #7A73FF;
}

.base-bottle {
  width: 82rpx;
  height: 118rpx;
}

.base-name {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.wizard-card {
  padding: 30rpx;
}

.hint {
  display: block;
  margin-top: 10rpx;
  color: #8A94A6;
  font-size: 22rpx;
}

.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.ingredient {
  min-height: 48rpx;
}

.selected-ingredient {
  background: linear-gradient(135deg, #7A73FF, #8C6BFF);
  color: #ffffff;
}

.info-input,
.info-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: rgba(248, 250, 255, 0.88);
  color: #1C1C1E;
  font-size: 26rpx;
}

.info-input {
  height: 84rpx;
}

.info-textarea {
  min-height: 150rpx;
  padding-top: 22rpx;
  line-height: 1.5;
}

.finish-card {
  padding: 38rpx 30rpx;
  text-align: center;
}

.finish-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #2ED573, #78E3A0);
  color: #ffffff;
  font-size: 42rpx;
}

.finish-title,
.finish-desc,
.summary-name,
.summary-meta {
  display: block;
}

.finish-title {
  margin-top: 18rpx;
  color: #1C1C1E;
  font-size: 32rpx;
  font-weight: 900;
}

.finish-desc {
  margin-top: 10rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.55;
}

.summary-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(248, 250, 255, 0.88);
  text-align: left;
}

.summary-bottle {
  width: 54rpx;
  height: 78rpx;
}

.summary-name {
  color: #1C1C1E;
  font-size: 25rpx;
  font-weight: 900;
}

.summary-meta {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 20rpx;
}

.next-button {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  height: 86rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7A73FF, #8C6BFF);
  box-shadow: 0 18rpx 44rpx rgba(122, 115, 255, 0.28);
  font-size: 28rpx;
}

.next-button.disabled {
  opacity: 0.72;
}
