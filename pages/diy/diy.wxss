.diy-page {
  background: linear-gradient(180deg, #fbfcff 0%, #f5f7fc 100%);
}

.step-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 0 42rpx;
}

.step {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #d9ddea;
  color: #ffffff;
  font-size: 20rpx;
}

.step-dot.active {
  background: #6C5CFF;
}

.step-text {
  color: #9ca3af;
  font-size: 22rpx;
}

.active-text {
  color: #111827;
  font-weight: 900;
}

.category-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.category-row,
.base-row {
  display: flex;
  gap: 18rpx;
}

.active-pill {
  background: rgba(108, 92, 255, 0.12);
  color: #6C5CFF;
}

.base-scroll {
  margin: 28rpx -28rpx 0 0;
  white-space: nowrap;
}

.base-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 174rpx;
  height: 230rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 16rpx 42rpx rgba(87, 98, 128, 0.08);
}

.base-bottle {
  width: 86rpx;
  height: 132rpx;
}

.base-card.selected {
  border-color: #6C5CFF;
}

.base-name {
  margin-top: 18rpx;
  font-size: 21rpx;
}

.picked-card {
  margin: 34rpx 0 26rpx;
  padding: 28rpx;
}

.picked,
.info-title,
.info-text {
  display: block;
}

.picked {
  font-weight: 900;
}

.selected-drink {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
}

.ingredient-card {
  margin: 34rpx 0 26rpx;
}

.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.ingredient {
  min-height: 48rpx;
}

.selected-ingredient {
  background: linear-gradient(135deg, #7C66FF, #A66BFF);
  color: #ffffff;
}

.info-input,
.info-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: rgba(248, 250, 255, 0.88);
  color: #1C1C1E;
  font-size: 26rpx;
}

.info-input {
  height: 84rpx;
}

.info-textarea {
  min-height: 150rpx;
  padding-top: 22rpx;
}

.selected-bottle {
  width: 52rpx;
  height: 78rpx;
}

.selected-name,
.selected-meta {
  display: block;
}

.selected-name {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
}

.selected-meta {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.remove {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #d1d5db;
  color: #ffffff;
}
