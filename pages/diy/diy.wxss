.diy-page {
  background: linear-gradient(180deg, #ffffff 0%, #f7f8fc 100%);
}

.nav-line {
  margin-top: 10rpx;
}

.back {
  font-size: 44rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 800;
}

.next {
  color: #6b4cff;
  font-size: 24rpx;
}

.step-row {
  display: flex;
  justify-content: space-between;
  margin: 40rpx 0 34rpx;
}

.step {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e5e7eb;
  color: #ffffff;
  font-size: 20rpx;
}

.step-dot.active {
  background: #6b4cff;
}

.step-text {
  color: #9ca3af;
  font-size: 22rpx;
}

.active-text {
  color: #111827;
  font-weight: 700;
}

.category-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.category-row,
.base-row {
  display: flex;
  gap: 18rpx;
}

.active-pill {
  background: #fff3e9;
  color: #d97706;
}

.base-scroll {
  margin: 28rpx -28rpx 0 0;
  white-space: nowrap;
}

.base-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 220rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(31, 41, 55, 0.07);
}

.base-bottle {
  width: 86rpx;
  height: 132rpx;
}

.base-card.selected {
  border-color: #6b4cff;
}

.base-name {
  margin-top: 18rpx;
  font-size: 21rpx;
}

.picked-card {
  margin: 34rpx 0 26rpx;
  padding: 28rpx;
}

.picked,
.info-title,
.info-text {
  display: block;
}

.picked {
  font-weight: 800;
}

.info-title {
  margin-top: 28rpx;
  color: #111827;
  font-weight: 700;
}

.info-text {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}
