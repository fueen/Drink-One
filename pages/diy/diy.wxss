.diy-page {
  padding-bottom: 164rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.recipe-list-panel {
  margin-top: 28rpx;
}

.my-recipe-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.my-recipe-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx;
}

.my-recipe-cover {
  width: 126rpx;
  height: 116rpx;
  border-radius: 20rpx;
  background: #eef2f8;
}

.my-recipe-copy {
  flex: 1;
  min-width: 0;
}

.my-recipe-name,
.my-recipe-desc,
.my-recipe-meta {
  display: block;
}

.my-recipe-name {
  color: #111318;
  font-size: 27rpx;
  font-weight: 900;
}

.my-recipe-desc {
  margin-top: 8rpx;
  color: #7f8794;
  font-size: 22rpx;
  line-height: 1.4;
}

.my-recipe-meta {
  margin-top: 10rpx;
  color: #ff5b64;
  font-size: 21rpx;
}

.step-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 30rpx 0 34rpx;
}

.step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #b0b6c2;
  font-size: 19rpx;
  white-space: nowrap;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eef1f6;
  color: #a3aab6;
  font-size: 19rpx;
}

.step.active .step-dot {
  background: linear-gradient(135deg, #ff6a55, #ff4f7b);
  color: #ffffff;
}

.step.active .step-text {
  color: #ff5b64;
}

.stepper-line {
  width: 22rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #e5e9f0;
}

.wizard-panel {
  margin-top: 8rpx;
}

.base-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.base-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 176rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #eef1f6;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(39, 48, 69, 0.06);
}

.base-card.selected {
  border-color: #ff6a55;
}

.base-bottle {
  width: 76rpx;
  height: 104rpx;
}

.base-name {
  display: block;
  margin-top: 10rpx;
  color: #303540;
  font-size: 21rpx;
  font-weight: 900;
}

.wizard-card {
  padding: 28rpx;
}

.hint {
  display: block;
  margin-top: 10rpx;
  color: #8d95a3;
  font-size: 22rpx;
}

.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.ingredient {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f6f7fa;
  color: #565f6d;
  font-size: 22rpx;
}

.selected-ingredient {
  background: linear-gradient(135deg, #ff9f45, #ff4f7b);
  color: #ffffff;
}

.info-input,
.info-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f8f9fc;
  color: #111318;
  font-size: 25rpx;
}

.info-input {
  height: 82rpx;
}

.info-textarea {
  min-height: 150rpx;
  padding-top: 22rpx;
  line-height: 1.5;
}

.finish-card {
  padding: 36rpx 28rpx;
  text-align: center;
}

.finish-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #2ed573;
  color: #ffffff;
  font-size: 40rpx;
}

.finish-title,
.finish-desc,
.summary-name,
.summary-meta {
  display: block;
}

.finish-title {
  margin-top: 18rpx;
  color: #111318;
  font-size: 32rpx;
  font-weight: 900;
}

.finish-desc {
  margin-top: 10rpx;
  color: #7f8794;
  font-size: 22rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8f9fc;
  text-align: left;
}

.summary-bottle {
  width: 54rpx;
  height: 78rpx;
}

.summary-name {
  color: #111318;
  font-size: 25rpx;
  font-weight: 900;
}

.summary-meta {
  margin-top: 6rpx;
  color: #7f8794;
  font-size: 20rpx;
}

.next-button.disabled {
  opacity: 0.72;
}
