<view class="page page-with-tab phone-page index-page">
  <view class="mock-status"><text>9:41</text><text class="status-icons">▮▮▮ ᯤ ▰</text></view>
  <view class="app-shell">
    <view class="home-head">
      <view>
        <text class="title">喝一杯</text>
        <text class="subtitle">今晚，喝一杯</text>
      </view>
      <text class="bell">♧</text>
    </view>

    <view class="search hero-search">⌕　搜索酒品、酒谱、品牌</view>

    <view class="safety-card">
      <view>
        <text class="safety-title">适量饮酒 · 理性饮酒</text>
        <text class="safety-text">过度饮酒可能伤身体健康</text>
        <text class="safety-text">未成年人禁止饮酒，酒后请勿驾车</text>
      </view>
      <text class="shield">♢</text>
    </view>

    <view class="mood-grid">
      <view class="mood-item" wx:for="{{moods}}" wx:key="name" bindtap="goMood" data-mood="{{item.name}}">
        <text class="mood-icon">{{item.icon}}</text>
        <text class="mood-name">{{item.name}}</text>
      </view>
    </view>

    <view class="random-card dice-card" bindtap="drawRandomDrink">
      <view>
        <text class="random-title">随机抽一杯</text>
        <text class="random-subtitle">看看命运今天会给你哪一杯</text>
      </view>
      <text class="dice">⚂</text>
    </view>

    <view class="between section-head">
      <text class="section-title">今日推荐</text>
      <text class="refresh" bindtap="drawRandomDrink">换一杯</text>
    </view>

    <view class="drink-hero-card" bindtap="goDetail">
      <image class="home-bottle" src="{{dailyDrink.image}}" mode="aspectFit"></image>
      <view class="home-drink-copy">
        <text class="home-drink-name">{{dailyDrink.name}}</text>
        <text class="home-drink-en">{{dailyDrink.englishName}}</text>
        <text class="home-drink-meta">{{dailyDrink.abv}} · 日本</text>
        <view class="home-tags">
          <text class="tag" wx:for="{{dailyDrink.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
