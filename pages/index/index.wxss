.phone-page {
  background:
    radial-gradient(circle at 18% 8%, rgba(122, 115, 255, 0.14), transparent 34%),
    radial-gradient(circle at 84% 22%, rgba(255, 184, 92, 0.14), transparent 32%),
    linear-gradient(180deg, #fbfcff 0%, #f6f8fd 54%, #ffffff 100%);
}

.home-head,
.brand-line,
.section-block,
.achievement-copy {
  min-width: 0;
}

.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  color: #111827;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
}

.subtitle {
  margin-left: 18rpx;
  color: #9CA3AF;
  font-size: 20rpx;
  font-style: italic;
  font-weight: 700;
}

.bell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #111827;
  font-size: 28rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.safety-card {
  display: block;
}

.status-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.status-card {
  min-height: 146rpx;
  box-sizing: border-box;
  padding: 18rpx 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  text-align: center;
  box-shadow: 0 16rpx 42rpx rgba(87, 98, 128, 0.08);
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin: 0 auto 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 36rpx;
}

.status-name,
.status-desc,
.random-title,
.recipe-name,
.recipe-meta,
.achievement-title,
.achievement-name,
.achievement-desc {
  display: block;
}

.status-name {
  color: #1C1C1E;
  font-size: 24rpx;
  font-weight: 900;
}

.status-desc {
  margin-top: 4rpx;
  color: #8A94A6;
  font-size: 18rpx;
}

.random-cta {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 126rpx;
  border-radius: 64rpx;
  background:
    linear-gradient(135deg, rgba(255, 198, 104, 0.3), transparent 48%),
    linear-gradient(180deg, #FFB85C 0%, #FF9966 100%);
  color: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(255, 153, 102, 0.28);
  overflow: hidden;
}

.random-title {
  font-size: 32rpx;
  font-weight: 900;
}

.random-bottle {
  position: absolute;
  right: 34rpx;
  bottom: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 60rpx;
  transform: rotate(-18deg);
}

.more {
  color: #9CA3AF;
  font-size: 22rpx;
  font-weight: 800;
}

.recipe-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.recipe-card {
  min-height: 226rpx;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 46rpx rgba(87, 98, 128, 0.08);
}

.recipe-cover {
  width: 100%;
  height: 118rpx;
  border-radius: 22rpx;
  background: #eef3ff;
}

.recipe-name {
  margin-top: 14rpx;
  color: #1C1C1E;
  font-size: 24rpx;
  font-weight: 900;
}

.recipe-meta {
  margin-top: 8rpx;
  color: #FF6F73;
  font-size: 20rpx;
}

.achievement-strip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 48rpx rgba(87, 98, 128, 0.08);
}

.badge-medal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff3d7, #ffe1a3);
  font-size: 38rpx;
}

.achievement-copy {
  flex: 1;
}

.achievement-title {
  color: #9CA3AF;
  font-size: 20rpx;
}

.achievement-name {
  margin-top: 4rpx;
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
}

.achievement-desc {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 21rpx;
}

.chevron {
  color: #9CA3AF;
  font-size: 38rpx;
}
