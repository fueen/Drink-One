.index-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.home-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 10rpx;
}

.brand-script,
.home-title,
.random-title,
.random-subtitle,
.random-arrow,
.status-name,
.recipe-name,
.recipe-author,
.achievement-title,
.achievement-name,
.achievement-desc {
  display: block;
}

.brand-script {
  margin-bottom: 12rpx;
  color: #ff5c3f;
  font-size: 22rpx;
  font-style: italic;
  font-weight: 700;
}

.home-title {
  color: #080a10;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
}

.home-bell {
  margin-top: 38rpx;
}

.safety-card {
  margin-top: 14rpx;
}

.home-random-card {
  position: relative;
  min-height: 236rpx;
  box-sizing: border-box;
  padding: 38rpx 34rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 72% 28%, rgba(255, 255, 255, 0.28), transparent 28%),
    linear-gradient(135deg, #ff4b62 0%, #ff8a42 52%, #ffc442 100%);
  box-shadow: 0 20rpx 42rpx rgba(255, 106, 78, 0.26);
  overflow: hidden;
}

.random-copy {
  position: relative;
  z-index: 2;
}

.random-title {
  margin-top: 54rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.random-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.random-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-top: 24rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #ff604f;
  font-size: 30rpx;
  font-weight: 900;
}

.random-visual {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  width: 188rpx;
  height: 166rpx;
  z-index: 1;
}

.spark {
  position: absolute;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  z-index: 2;
}

.s1 {
  right: 26rpx;
  top: 40rpx;
}

.s2 {
  right: 112rpx;
  bottom: 48rpx;
}

.s3 {
  left: 214rpx;
  bottom: 66rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.status-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.status-card {
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 14rpx 6rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(39, 48, 69, 0.06);
}

.status-icon {
  display: block;
  width: 52rpx;
  height: 52rpx;
  margin: 0 auto 8rpx;
}

.status-name {
  color: #1b1e27;
  font-size: 21rpx;
  font-weight: 900;
}

.recipe-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.recipe-card {
  min-height: 178rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(39, 48, 69, 0.07);
  overflow: hidden;
}

.recipe-cover {
  width: 100%;
  height: 108rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #fff7ec, #fff0f5);
}

.recipe-name {
  margin-top: 10rpx;
  color: #1b1e27;
  font-size: 23rpx;
  font-weight: 900;
}

.recipe-author-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.avatar-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7a64ff, #52c8ff);
}

.recipe-author {
  color: #8790a0;
  font-size: 18rpx;
}

.achievement-strip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(39, 48, 69, 0.07);
}

.badge-medal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #fff1dc;
  font-size: 34rpx;
}

.achievement-copy {
  flex: 1;
  min-width: 0;
}

.achievement-title {
  color: #9aa2af;
  font-size: 20rpx;
}

.achievement-name {
  margin-top: 4rpx;
  color: #1b1e27;
  font-size: 25rpx;
  font-weight: 900;
}

.achievement-desc {
  margin-top: 4rpx;
  color: #8790a0;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  color: #aeb4bf;
  font-size: 34rpx;
}
