.phone-page {
  background:
    radial-gradient(circle at 16% 8%, rgba(107, 76, 255, 0.1), transparent 34%),
    linear-gradient(180deg, #ffffff 0%, #f7f8fc 42%, #ffffff 100%);
}

.header {
  margin-top: 12rpx;
}

.title {
  display: block;
  color: #111827;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.round-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid #eef0f6;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #111827;
  font-size: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.06);
}

.hero-search {
  margin-top: 28rpx;
}

.mood-panel {
  position: relative;
  margin-top: 28rpx;
  padding: 28rpx 24rpx 26rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(135deg, rgba(83, 115, 255, 0.96) 0%, rgba(155, 83, 255, 0.96) 58%, rgba(255, 127, 159, 0.96) 100%);
  color: #ffffff;
  overflow: hidden;
  box-shadow: 0 22rpx 42rpx rgba(116, 77, 255, 0.24);
}

.mood-orb {
  position: absolute;
  border-radius: 32rpx;
  transform: rotate(24deg);
  opacity: 0.5;
}

.orb-a {
  right: -12rpx;
  top: 22rpx;
  width: 76rpx;
  height: 88rpx;
  background: linear-gradient(180deg, #ff9f7d, #ff6f9b);
}

.orb-b {
  right: 44rpx;
  bottom: -32rpx;
  width: 118rpx;
  height: 118rpx;
  background: rgba(255, 255, 255, 0.15);
}

.panel-title {
  position: relative;
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  z-index: 1;
}

.panel-subtitle {
  position: relative;
  display: block;
  margin-top: 4rpx;
  opacity: 0.76;
  font-size: 20rpx;
  z-index: 1;
}

.mood-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  z-index: 1;
}

.mood-item {
  text-align: center;
}

.mood-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  font-size: 40rpx;
  box-shadow: inset 0 -6rpx 16rpx rgba(255, 198, 111, 0.22), 0 12rpx 24rpx rgba(43, 31, 112, 0.18);
}

.mood-name {
  display: block;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.random-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 28rpx 30rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #793cff 0%, #ff78b9 100%);
  color: #ffffff;
  box-shadow: 0 20rpx 44rpx rgba(125, 69, 255, 0.28);
}

.random-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
}

.random-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.random-arrow {
  font-size: 56rpx;
  line-height: 1;
}

.section-head {
  margin-top: 30rpx;
  margin-bottom: 18rpx;
}

.refresh {
  color: #6b4cff;
  font-size: 22rpx;
}

.drink-card {
  display: flex;
  gap: 28rpx;
  padding: 28rpx;
}

.drink-hero-card {
  border-color: #edf0f7;
  box-shadow: 0 20rpx 52rpx rgba(31, 41, 55, 0.09);
}

.bottle-stage {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 118rpx;
  min-height: 172rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #ffffff 100%);
}

.drink-image {
  display: block;
}

.hero-bottle {
  width: 112rpx;
  height: 176rpx;
}

.drink-info {
  flex: 1;
  min-width: 0;
}

.drink-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.drink-en,
.drink-meta {
  display: block;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.tag-row {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.drink-note {
  display: block;
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 1.45;
}

.safety-strip {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f2bc6a;
  border-radius: 16rpx;
  background: #fff8ec;
}

.safety-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 2rpx solid #f59e0b;
  color: #d97706;
  font-size: 20rpx;
  font-weight: 900;
}

.safety-title {
  display: block;
  color: #d97706;
  font-weight: 800;
}

.safety-text {
  display: block;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 30rpx;
  line-height: 1.45;
}
