.phone-page {
  background:
    radial-gradient(circle at 16% 7%, rgba(116, 96, 255, 0.14), transparent 32%),
    linear-gradient(180deg, #f7faff 0%, #f5f7fc 52%, #ffffff 100%);
}

.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
}

.subtitle {
  display: block;
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 800;
}

.bell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #111827;
  font-size: 28rpx;
}

.safety-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 18rpx 56rpx rgba(87, 98, 128, 0.08);
  backdrop-filter: blur(24px);
}

.safety-title,
.safety-text {
  display: block;
}

.safety-title {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
}

.safety-text {
  margin-top: 6rpx;
  color: #677184;
  font-size: 21rpx;
  font-weight: 700;
}

.shield {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: rgba(105, 167, 255, 0.16);
  color: #6C5CFF;
  font-size: 34rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.mood-item {
  min-height: 138rpx;
  padding: 20rpx 6rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
  box-shadow: 0 16rpx 42rpx rgba(87, 98, 128, 0.08);
}

.mood-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  font-size: 40rpx;
}

.mood-name {
  display: block;
  color: #1C1C1E;
  font-size: 24rpx;
  font-weight: 900;
}

.random-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 142rpx;
  padding: 26rpx 30rpx;
  min-height: 136rpx;
  border-radius: 68rpx;
  background: linear-gradient(180deg, #FFB85C 0%, #FF9966 100%);
  color: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(255, 184, 92, 0.25);
}

.random-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.random-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.dice {
  color: rgba(255, 255, 255, 0.7);
  font-size: 92rpx;
  line-height: 1;
}

.section-head {
  margin-top: 30rpx;
  margin-bottom: 18rpx;
}

.refresh {
  color: #9aa3b5;
  font-size: 22rpx;
  font-weight: 800;
}

.drink-hero-card {
  display: flex;
  align-items: center;
  gap: 30rpx;
  min-height: 204rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 20rpx 60rpx rgba(87, 98, 128, 0.09);
}

.home-bottle {
  width: 112rpx;
  height: 166rpx;
}

.home-drink-copy {
  flex: 1;
  min-width: 0;
}

.home-drink-name,
.home-drink-en,
.home-drink-meta {
  display: block;
}

.home-drink-name {
  color: #1C1C1E;
  font-size: 28rpx;
  font-weight: 900;
}

.home-drink-en,
.home-drink-meta {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
}

.home-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}
