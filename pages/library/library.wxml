<view class="v3-page page-with-tab v3-library library-page">
  <view class="library-header">
    <text class="v3-title">酒库</text>
    <text class="v3-icon-button library-notify">♡</text>
  </view>

  <input class="v3-search library-search" placeholder="⌕  搜索酒品、品牌、类型" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search"></input>
  <text class="sr-only">全部 威士忌</text>

  <scroll-view class="category-tabs" scroll-x="true" show-scrollbar="false">
    <view class="category-track">
      <text
        class="category-tab {{item === activeCategory ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-category="{{item}}"
        bindtap="selectCategory"
      >{{item}}</text>
    </view>
  </scroll-view>

  <view class="drink-grid">
    <view
      class="drink-tile tap-scale"
      wx:for="{{filteredDrinks}}"
      wx:key="name"
      data-index="{{index}}"
      bindtap="goDetail"
      hover-class="pressing"
    >
      <image class="library-bottle" src="{{item.image}}" mode="aspectFit"></image>
      <text class="drink-name">{{item.name}}</text>
      <text class="drink-abv">{{item.abv}}</text>
      <text class="library-card-metric" data-index="{{index}}" catchtap="toggleLike">♥ {{item.favoriteCount || item.likes || '965'}}</text>
    </view>
  </view>
</view>
