<view class="page library-page page-with-tab">
  <view class="top-bar">
    <text class="top-title align-left">酒库</text>
    <text class="nav-action">⌕</text>
  </view>
  <input class="search library-search" placeholder="⌕　搜索酒品、品牌、类型" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search"></input>
  <text class="sr-only">全部 威士忌</text>
  <scroll-view class="category-tabs" scroll-x="true" show-scrollbar="false">
    <view class="category-track">
      <text
        class="category-tab {{item === activeCategory ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-category="{{item}}"
        bindtap="selectCategory"
      >{{item}}</text>
    </view>
  </scroll-view>
  <view class="drink-grid">
    <view
      class="drink-tile tap-scale"
      wx:for="{{filteredDrinks}}"
      wx:key="name"
      data-index="{{index}}"
      bindtap="goDetail"
      hover-class="pressing"
    >
      <text
        class="heart {{item.liked ? 'active' : ''}}"
        data-index="{{index}}"
        catchtap="toggleLike"
      >♥</text>
      <image class="library-bottle" src="{{item.image}}" mode="aspectFit"></image>
      <text class="drink-name">{{item.name}}</text>
      <text class="drink-abv">{{item.abv}}</text>
      <text class="drink-likes">♥ {{item.favoriteCount || item.likes || '965'}}</text>
    </view>
  </view>
</view>
