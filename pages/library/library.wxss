.library-page {
  background:
    radial-gradient(circle at 18% 8%, rgba(255, 184, 92, 0.12), transparent 32%),
    linear-gradient(180deg, #fbfcff 0%, #f6f8fc 100%);
}

.align-left {
  text-align: left;
}

.library-search {
  margin-top: 8rpx;
}

.category-tabs {
  margin: 26rpx -28rpx 8rpx 0;
  white-space: nowrap;
}

.category-track {
  display: flex;
  gap: 18rpx;
  padding-right: 28rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 86rpx;
  height: 48rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #6B7280;
  font-size: 22rpx;
}

.category-tab.active {
  background: linear-gradient(135deg, #7A73FF, #8C6BFF);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(122, 115, 255, 0.25);
}

.drink-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 26rpx;
}

.drink-tile {
  position: relative;
  min-height: 258rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 46rpx rgba(87, 98, 128, 0.08);
}

.heart {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  color: #FF6F73;
  font-size: 20rpx;
}

.heart.active {
  color: #FF4F62;
}

.library-bottle {
  display: block;
  width: 92rpx;
  height: 138rpx;
  margin: 4rpx auto 16rpx;
  filter: drop-shadow(0 18rpx 20rpx rgba(125, 76, 26, 0.16));
}

.drink-name,
.drink-abv,
.drink-likes {
  display: block;
}

.drink-name {
  color: #1C1C1E;
  font-size: 24rpx;
  font-weight: 900;
}

.drink-abv {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 20rpx;
}

.drink-likes {
  margin-top: 8rpx;
  padding-left: 28rpx;
  color: #FF6F73;
  font-size: 19rpx;
}
