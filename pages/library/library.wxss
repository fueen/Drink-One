.library-page {
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.library-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
}

.library-notify {
  color: #111318;
}

.library-search {
  width: 100%;
  margin-top: 22rpx;
}

.category-tabs {
  margin: 24rpx -32rpx 8rpx 0;
  white-space: nowrap;
}

.category-track {
  display: flex;
  gap: 14rpx;
  padding-right: 32rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  height: 48rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6f7785;
  font-size: 21rpx;
  box-shadow: 0 8rpx 20rpx rgba(39, 48, 69, 0.05);
}

.category-tab.active {
  background: #ff8a42;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(255, 138, 66, 0.24);
}

.drink-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.drink-tile {
  min-height: 262rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx 18rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(39, 48, 69, 0.06);
}

.library-bottle {
  display: block;
  width: 92rpx;
  height: 130rpx;
  margin: 0 auto 12rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(122, 70, 27, 0.16));
}

.drink-name,
.drink-abv,
.library-card-metric {
  display: block;
}

.drink-name {
  color: #111318;
  font-size: 23rpx;
  font-weight: 900;
}

.drink-abv {
  margin-top: 5rpx;
  color: #8d95a3;
  font-size: 19rpx;
}

.library-card-metric {
  margin-top: 9rpx;
  color: #ff5b64;
  font-size: 19rpx;
}
