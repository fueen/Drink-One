<view class="page mood-page">
  <view class="mock-status"><text>9:41</text><text class="status-icons">▮▮▮ ᯤ ▰</text></view>
  <view class="top-bar">
    <text class="nav-back">‹</text>
    <text class="top-title">状态推荐</text>
    <text class="nav-action">记录</text>
  </view>

  <view class="mood-hero">
    <text class="page-title">选择你的此刻状态</text>
    <text class="page-subtitle">我们为你推荐最适合的一杯</text>
  </view>

  <view class="state-grid">
    <view class="state-card mint" bindtap="loadMore">
      <text class="state-icon">😌</text>
      <text class="state-title">微醺模式</text>
      <text class="state-desc">放松心情</text>
    </view>
    <view class="state-card lavender">
      <text class="state-icon">🍻</text>
      <text class="state-title">小酌模式</text>
      <text class="state-desc">享受快乐</text>
    </view>
    <view class="state-card rose">
      <text class="state-icon">🍒</text>
      <text class="state-title">重口感模式</text>
      <text class="state-desc">浓烈神秘</text>
    </view>
    <view class="state-card cream">
      <text class="state-icon">🎉</text>
      <text class="state-title">聚会模式</text>
      <text class="state-desc">多人分享</text>
    </view>
  </view>

  <view class="glass-card mood-record">
    <view>
      <text class="record-title">我的状态记录</text>
      <text class="record-desc">本周已探索 12 种酒品</text>
    </view>
    <text class="record-arrow">›</text>
  </view>
</view>
