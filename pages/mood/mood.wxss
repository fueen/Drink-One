.mood-page {
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.mood-hero {
  margin: 34rpx 0 28rpx;
}

.state-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.state-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 222rpx;
  box-sizing: border-box;
  padding: 28rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(39, 48, 69, 0.06);
}

.mint {
  background: linear-gradient(145deg, #effff9, #ffffff);
}

.lavender {
  background: linear-gradient(145deg, #f3f1ff, #ffffff);
}

.rose {
  background: linear-gradient(145deg, #fff3f5, #ffffff);
}

.cream {
  background: linear-gradient(145deg, #fff8eb, #ffffff);
}

.state-icon,
.state-title,
.state-desc,
.record-title,
.record-desc {
  display: block;
}

.state-icon {
  font-size: 56rpx;
}

.state-title {
  margin-top: 22rpx;
  color: #111318;
  font-size: 28rpx;
  font-weight: 900;
}

.state-desc {
  margin-top: 8rpx;
  color: #8d95a3;
  font-size: 22rpx;
}

.mood-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 28rpx;
}

.record-title {
  color: #111318;
  font-size: 26rpx;
  font-weight: 900;
}

.record-desc {
  margin-top: 8rpx;
  color: #8d95a3;
  font-size: 22rpx;
}

.record-arrow {
  color: #b0b6c2;
  font-size: 34rpx;
}
