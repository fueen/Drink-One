.page-title {
  display: block;
  color: #111827;
  text-align: center;
  font-size: 42rpx;
  font-weight: 900;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a94a6;
  text-align: center;
  font-size: 24rpx;
}

.mood-hero {
  margin: 34rpx 0 26rpx;
}

.state-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 270rpx;
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 20rpx 60rpx rgba(87, 98, 128, 0.09);
  backdrop-filter: blur(24px);
}

.mint {
  background: linear-gradient(145deg, rgba(240, 255, 250, 0.92), rgba(255, 255, 255, 0.74));
}

.lavender {
  background: linear-gradient(145deg, rgba(244, 242, 255, 0.94), rgba(255, 255, 255, 0.74));
}

.rose {
  background: linear-gradient(145deg, rgba(255, 244, 246, 0.94), rgba(255, 255, 255, 0.74));
}

.cream {
  background: linear-gradient(145deg, rgba(255, 250, 235, 0.94), rgba(255, 255, 255, 0.74));
}

.state-icon {
  display: block;
  font-size: 64rpx;
}

.state-title,
.state-desc,
.record-title,
.record-desc {
  display: block;
}

.state-title {
  margin-top: 24rpx;
  color: #1C1C1E;
  font-size: 28rpx;
  font-weight: 900;
}

.state-desc {
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.mood-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
}

.record-title {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
}

.record-desc {
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.record-arrow {
  font-size: 34rpx;
}
