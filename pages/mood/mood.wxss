.page-title {
  display: block;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 24rpx;
}

.hero-emoji {
  font-size: 104rpx;
}

.scene-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 42rpx 0 34rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 18rpx 0 30rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 16rpx 22rpx;
}

.mini {
  width: 42rpx;
  height: 76rpx;
  border-radius: 10rpx;
}

.mini::before {
  left: 12rpx;
  top: -18rpx;
  width: 18rpx;
  height: 24rpx;
}

.mini::after {
  left: 7rpx;
  right: 7rpx;
  top: 28rpx;
  height: 20rpx;
}

.recommend-info {
  flex: 1;
  margin-left: 26rpx;
}

.drink-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.drink-en {
  display: block;
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.heart {
  color: #9ca3af;
  font-size: 36rpx;
}

.heart.active {
  color: #ff6f73;
}

.recommend-item:active {
  background: #f9fafb;
}

.primary-button {
  margin-top: 0;
}
