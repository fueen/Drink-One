<view class="page profile-page page-with-tab">
  <view class="profile-head">
    <view class="avatar">猫</view>
    <view>
      <text class="nickname">微醺的猫</text>
      <text class="bio">爱生活，爱微醺</text>
    </view>
  </view>
  <view class="card stat-card">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>
  <view class="menu-list">
    <view class="menu-row" wx:for="{{menus}}" wx:key="*this">
      <text>{{item}}</text>
      <text>›</text>
    </view>
  </view>
</view>
