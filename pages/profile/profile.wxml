<view class="page profile-page page-with-tab">
  <view class="mock-status"><text>9:41</text><text class="status-icons">▮▮▮ ᯤ ▰</text></view>
  <view class="profile-head">
    <view class="avatar">👦🏻</view>
    <view>
      <text class="nickname">{{user ? user.nickname || '微醺的猫' : '微醺的猫'}}</text>
      <text class="bio">爱生活，爱微醺　♡ VIP</text>
    </view>
  </view>
  <view class="card stat-card">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>
  <view class="menu-list">
    <view
      class="menu-row"
      wx:for="{{menus}}"
      wx:key="name"
      data-index="{{index}}"
      bindtap="goMenu"
    >
      <text>{{item.name}}</text>
      <text>›</text>
    </view>
  </view>
</view>
