<view class="page profile-page page-with-tab">
  <view class="profile-card">
    <view class="avatar">👦🏻</view>
    <view class="profile-copy">
      <text class="nickname">{{user ? user.nickname || '微醺的猫' : '微醺的猫'}}</text>
      <text class="bio">ID: drink_one_666</text>
    </view>
    <button class="edit-button">编辑资料</button>
  </view>
  <view class="card stat-card">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>
  <view class="menu-list">
    <view
      class="menu-row"
      wx:for="{{menus}}"
      wx:key="name"
      data-index="{{index}}"
      bindtap="goMenu"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
</view>
