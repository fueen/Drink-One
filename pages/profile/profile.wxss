.profile-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 28rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #78d8ff 0%, #ffd17d 100%);
  color: #111827;
  font-weight: 800;
}

.nickname,
.bio {
  display: block;
}

.nickname {
  font-size: 32rpx;
  font-weight: 800;
}

.bio {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.stat-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 38rpx 0 28rpx;
  padding: 26rpx 0;
}

.stat {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.menu-list {
  border-radius: 18rpx;
  background: #ffffff;
  overflow: hidden;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eef0f6;
}

.menu-row:last-child {
  border-bottom: 0;
}
