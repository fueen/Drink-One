.profile-page {
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.profile-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 166rpx;
  box-sizing: border-box;
  margin: -22rpx -32rpx 0;
  padding: 38rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #7a64ff 0%, #8c6bff 56%, #b675ff 100%);
  color: #ffffff;
}

.avatar {
  width: 82rpx;
  height: 82rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 50%;
  background: #ffffff;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.nickname,
.bio,
.stat-value,
.stat-label,
.service-name {
  display: block;
}

.nickname {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.bio {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
}

.level-pill {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 900;
}

.stat-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: -28rpx;
  padding: 24rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(39, 48, 69, 0.08);
  position: relative;
  z-index: 2;
}

.stat {
  text-align: center;
}

.stat-value {
  color: #111318;
  font-size: 28rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 7rpx;
  color: #7f8794;
  font-size: 18rpx;
}

.service-block {
  margin-top: 28rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ff6580, #ff9f45);
  color: #ffffff;
  font-size: 25rpx;
}

.service-name {
  color: #565f6d;
  font-size: 18rpx;
}

.menu-list {
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(39, 48, 69, 0.06);
  overflow: hidden;
}

.menu-row,
.menu-left {
  display: flex;
  align-items: center;
}

.menu-row {
  justify-content: space-between;
  min-height: 82rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f2f6;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-left {
  gap: 18rpx;
  color: #111318;
  font-size: 24rpx;
}

.menu-icon {
  width: 32rpx;
  color: #111318;
  text-align: center;
}

.chevron {
  color: #aeb4bf;
  font-size: 32rpx;
}
