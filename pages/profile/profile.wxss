.profile-page {
  background:
    radial-gradient(circle at 16% 8%, rgba(255, 184, 92, 0.14), transparent 30%),
    linear-gradient(180deg, #fbfcff 0%, #f7f8fc 100%);
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 20rpx 56rpx rgba(87, 98, 128, 0.08);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #78D8FF 0%, #FFD17D 100%);
  font-size: 46rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.nickname,
.bio,
.stat-value,
.stat-label {
  display: block;
}

.nickname {
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 900;
}

.bio {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 21rpx;
}

.edit-button {
  width: 130rpx;
  height: 54rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(122, 115, 255, 0.1);
  color: #6C5CFF;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.stat-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin: 28rpx 0;
  padding: 26rpx 0;
}

.stat {
  text-align: center;
}

.stat-value {
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 20rpx;
}

.menu-list {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 56rpx rgba(87, 98, 128, 0.08);
  overflow: hidden;
}

.menu-row,
.menu-left {
  display: flex;
  align-items: center;
}

.menu-row {
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-left {
  gap: 20rpx;
  color: #1C1C1E;
  font-size: 25rpx;
}

.menu-icon {
  width: 34rpx;
  color: #7A73FF;
  text-align: center;
}

.chevron {
  color: #9CA3AF;
  font-size: 34rpx;
}
