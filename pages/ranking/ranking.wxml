<view class="page ranking-page page-with-tab">
  <view class="mock-status"><text>9:41</text><text class="status-icons">▮▮▮ ᯤ ▰</text></view>
  <view class="top-bar">
    <text class="nav-back">‹</text>
    <text class="top-title">排行榜</text>
    <text class="nav-action"></text>
  </view>
  <view class="rank-tabs">
    <text class="rank-tab {{activeTab === 0 ? 'active' : ''}}" data-index="0" bindtap="switchTab">热门榜</text>
    <text class="rank-tab {{activeTab === 1 ? 'active' : ''}}" data-index="1" bindtap="switchTab">收藏榜</text>
    <text class="rank-tab {{activeTab === 2 ? 'active' : ''}}" data-index="2" bindtap="switchTab">创意榜</text>
    <text class="rank-tab {{activeTab === 3 ? 'active' : ''}}" data-index="3" bindtap="switchTab">品鉴榜</text>
  </view>
  <view class="podium">
    <view class="podium-item rank-{{item.rank}}" wx:for="{{top}}" wx:key="name">
      <text class="crown">♕</text>
      <image class="podium-bottle" src="{{item.image}}" mode="aspectFit"></image>
      <text class="podium-name">{{item.name}}</text>
      <text class="likes">♥ {{item.likes}}</text>
    </view>
  </view>
  <view class="rank-list">
    <view class="soft-card rank-row" wx:for="{{list}}" wx:key="name">
      <text class="rank-num">{{item.rank}}</text>
      <image class="rank-bottle" src="{{item.image}}" mode="aspectFit"></image>
      <text class="rank-name">{{item.name}}</text>
      <text class="rank-like">♡ {{item.likes}}</text>
    </view>
  </view>
</view>
