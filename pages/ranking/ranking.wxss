.ranking-page {
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.rank-tabs {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0 28rpx;
}

.rank-tab {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  color: #8d95a3;
  font-size: 23rpx;
  font-weight: 900;
}

.rank-tab.active {
  background: linear-gradient(135deg, #ff9f45, #ff4f7b);
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(255, 79, 123, 0.22);
}

.podium {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: end;
  gap: 14rpx;
  min-height: 312rpx;
}

.podium-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 224rpx;
  box-sizing: border-box;
  padding: 28rpx 8rpx 18rpx;
  border-radius: 70rpx 70rpx 22rpx 22rpx;
  background: linear-gradient(180deg, #fff8eb 0%, #ffffff 100%);
  box-shadow: 0 12rpx 30rpx rgba(39, 48, 69, 0.07);
}

.rank-1 {
  min-height: 282rpx;
}

.rank-2 {
  min-height: 238rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #ffffff 100%);
}

.rank-3 {
  min-height: 232rpx;
  background: linear-gradient(180deg, #fff1ec 0%, #ffffff 100%);
}

.podium-rank-badge {
  position: absolute;
  top: -14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #ffb22e;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.podium-bottle {
  width: 72rpx;
  height: 104rpx;
  border-radius: 50%;
}

.podium-name,
.likes {
  display: block;
  margin-top: 10rpx;
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
  font-weight: 900;
}

.likes {
  color: #ff5b64;
  font-size: 18rpx;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 74rpx;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.rank-num {
  width: 34rpx;
  color: #111318;
  font-weight: 900;
}

.rank-bottle {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
}

.rank-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111318;
  font-size: 24rpx;
}

.rank-like {
  color: #8d95a3;
  font-size: 22rpx;
}
