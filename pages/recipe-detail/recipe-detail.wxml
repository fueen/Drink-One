<view class="v3-page v3-recipe-detail recipe-detail-page">
  <view class="v3-topbar">
    <text class="v3-back" bindtap="goBack">‹</text>
    <text class="v3-topbar-title"></text>
    <text class="v3-icon-button">•••</text>
  </view>

  <view class="recipe-cover-hero">
    <image class="recipe-cover-image" src="{{recipe.cover || '/assets/ui-v3/recipe-cocktail.png'}}" mode="aspectFit"></image>
  </view>

  <view class="v3-card recipe-info">
    <view class="recipe-head">
      <view class="recipe-title-wrap">
        <text class="recipe-title">{{recipe.name}}</text>
        <text class="recipe-author">👤 {{recipe.author}}</text>
      </view>
      <button class="follow-button">关注</button>
    </view>
    <text class="recipe-desc">{{recipe.description}}</text>
    <view class="recipe-stats">
      <text>♥ {{recipe.likes}}</text>
      <text>★ 4.8</text>
      <text>▱ {{recipe.favorites}}</text>
    </view>
  </view>

  <view class="v3-card ingredient-card">
    <text class="v3-section-title">配料</text>
    <view class="ingredient-line">
      <text>🍾</text>
      <text class="ingredient-name">{{recipe.baseDrink}}</text>
      <text class="ingredient-amount">45ml</text>
    </view>
    <view class="ingredient-line" wx:for="{{recipe.ingredients}}" wx:key="*this">
      <text>◌</text>
      <text class="ingredient-name">{{item}}</text>
      <text class="ingredient-amount">{{index === 0 ? '15ml' : index === 1 ? '适量' : '1片'}}</text>
    </view>
  </view>

  <view class="v3-card action-bar">
    <view class="action-item" bindtap="likeRecipe">
      <text class="action-icon">♥</text>
      <text>点赞</text>
    </view>
    <view class="action-item" bindtap="favoriteRecipe">
      <text class="action-icon">★</text>
      <text>收藏</text>
    </view>
    <view class="action-item report" bindtap="reportRecipe">
      <text class="action-icon">!</text>
      <text>举报</text>
    </view>
  </view>
</view>
