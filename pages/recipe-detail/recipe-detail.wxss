.recipe-detail-page {
  padding-bottom: 54rpx;
  background:
    radial-gradient(circle at 50% 8%, rgba(114, 169, 255, 0.16), transparent 30%),
    linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.recipe-cover-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 370rpx;
  margin-top: 4rpx;
  overflow: hidden;
}

.recipe-cover-image {
  width: 420rpx;
  height: 330rpx;
  filter: drop-shadow(0 30rpx 34rpx rgba(164, 135, 59, 0.2));
}

.recipe-info {
  margin-top: -20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
}

.recipe-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.recipe-title-wrap {
  flex: 1;
  min-width: 0;
}

.recipe-title,
.recipe-author,
.recipe-desc {
  display: block;
}

.recipe-title {
  color: #111318;
  font-size: 38rpx;
  font-weight: 900;
}

.recipe-author {
  margin-top: 8rpx;
  color: #7f8794;
  font-size: 22rpx;
}

.follow-button {
  width: 88rpx;
  height: 46rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3edff;
  color: #7a64ff;
  font-size: 20rpx;
  line-height: 46rpx;
}

.recipe-desc {
  margin-top: 18rpx;
  color: #7f8794;
  font-size: 24rpx;
  line-height: 1.55;
}

.recipe-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 22rpx;
  color: #ff5b64;
  font-size: 22rpx;
  font-weight: 900;
}

.ingredient-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.ingredient-line {
  display: grid;
  grid-template-columns: 38rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  min-height: 58rpx;
  color: #565f6d;
  font-size: 24rpx;
}

.ingredient-line:first-of-type {
  margin-top: 16rpx;
}

.ingredient-name {
  color: #20232b;
}

.ingredient-amount {
  color: #8d95a3;
}

.action-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #5f6876;
  font-size: 22rpx;
}

.action-icon {
  color: #ff8a42;
  font-size: 34rpx;
  font-weight: 900;
}

.report .action-icon {
  color: #ffa502;
}
