.recipe-detail-page {
  padding-top: 28rpx;
}

.recipe-cover-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 184, 92, 0.26), transparent 42%),
    rgba(255, 255, 255, 0.72);
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.recipe-cover-image {
  width: 220rpx;
  height: 280rpx;
}

.recipe-info {
  margin-top: 28rpx;
}

.recipe-title,
.recipe-author,
.recipe-desc,
.base-drink {
  display: block;
}

.recipe-title {
  color: #1C1C1E;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.recipe-author,
.base-drink {
  margin-top: 14rpx;
  color: #6B7280;
  font-size: 26rpx;
}

.recipe-desc {
  margin-top: 20rpx;
  color: #1C1C1E;
  font-size: 28rpx;
  line-height: 1.6;
}

.ingredient-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #1C1C1E;
  font-size: 24rpx;
}

.action-icon {
  color: #FF9966;
  font-size: 36rpx;
  font-weight: 700;
}

.report .action-icon {
  color: #FFA502;
}
