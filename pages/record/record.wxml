<view class="page record-page">
  <view class="mock-status"><text>9:41</text><text class="status-icons">▮▮▮ ᯤ ▰</text></view>
  <view class="top-bar">
    <text class="nav-back">‹</text>
    <text class="top-title">记录品鉴</text>
    <text class="nav-action" bindtap="saveRecord">保存</text>
  </view>
  <view class="glass-card drink-summary">
    <image class="summary-bottle" src="{{drink.image}}" mode="aspectFit"></image>
    <view>
      <text class="drink-name">{{drink.name}}</text>
      <text class="drink-en">{{drink.englishName}}</text>
      <text class="drink-abv">{{drink.abv}} · 日本</text>
    </view>
  </view>
  <view class="glass-card form">
    <text class="label">我的评分</text>
    <view class="stars">
      <text
        wx:for="{{stars}}"
        wx:key="*this"
        class="star {{index < rating ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="setRating"
      >★</text>
    </view>
    <text class="label">饮用场景</text>
    <view class="scene-row">
      <text
        class="pill {{item === scene ? 'active' : ''}}"
        wx:for="{{scenes}}"
        wx:key="*this"
        data-scene="{{item}}"
        bindtap="selectScene"
      >{{item}}</text>
    </view>
    <text class="label">口感标签（可多选）</text>
    <view class="scene-row">
      <text
        class="pill {{item === taste ? 'active' : ''}}"
        wx:for="{{tasteTags}}"
        wx:key="*this"
        data-taste="{{item}}"
        bindtap="selectTaste"
      >{{item}}</text>
    </view>
    <text class="label">个人笔记（选填）</text>
    <textarea class="textarea" placeholder="记录此刻的感受..." value="{{note}}" bindinput="onNoteInput"></textarea>
  </view>
</view>
