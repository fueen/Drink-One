<view class="page record-page">
  <text class="page-title">记录这款酒</text>
  <view class="drink-summary">
    <image class="bottle small" src="{{drink.image}}" mode="aspectFit"></image>
    <view>
      <text class="drink-name">{{drink.name}}</text>
      <text class="drink-en">{{drink.englishName}}</text>
      <text class="drink-abv">{{drink.abv}}</text>
    </view>
  </view>
  <view class="card form">
    <text class="label">我的评分</text>
    <view class="stars">
      <text
        wx:for="{{stars}}"
        wx:key="*this"
        class="star {{index < rating ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="setRating"
      >★</text>
    </view>
    <text class="label">饮用感受（可选）</text>
    <textarea class="textarea" placeholder="记录下这款酒的口感、香气和感受..." value="{{note}}" bindinput="onNoteInput"></textarea>
    <text class="label">饮用场景</text>
    <view class="scene-row">
      <text
        class="pill {{item === scene ? 'active' : ''}}"
        wx:for="{{scenes}}"
        wx:key="*this"
        data-scene="{{item}}"
        bindtap="selectScene"
      >{{item}}</text>
    </view>
  </view>
  <view class="primary-button" bindtap="saveRecord">保存记录</view>
</view>
