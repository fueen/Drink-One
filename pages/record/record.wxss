.drink-summary {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin: 20rpx 0 28rpx;
  padding: 18rpx 28rpx;
}

.summary-bottle {
  width: 76rpx;
  height: 118rpx;
}

.drink-name,
.drink-en,
.drink-abv,
.label {
  display: block;
}

.drink-name {
  font-size: 30rpx;
  font-weight: 900;
}

.drink-en,
.drink-abv {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.label {
  margin-top: 26rpx;
  color: #111827;
  font-weight: 900;
}

.label:first-child {
  margin-top: 0;
}

.stars {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.star {
  color: #e5e7eb;
  font-size: 48rpx;
}

.star.active {
  color: #f6bd16;
}

.textarea {
  min-height: 138rpx;
  margin-top: 18rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(248, 250, 255, 0.88);
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.scene-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 18rpx 0 20rpx;
}

.pill.active {
  background: linear-gradient(135deg, #7C66FF, #A66BFF);
  color: #ffffff;
}
