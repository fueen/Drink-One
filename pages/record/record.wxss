.record-page {
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.drink-summary {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 22rpx 0 24rpx;
  padding: 18rpx 24rpx;
}

.summary-bottle {
  width: 76rpx;
  height: 112rpx;
}

.drink-name,
.drink-en,
.drink-abv,
.label {
  display: block;
}

.drink-name {
  color: #111318;
  font-size: 30rpx;
  font-weight: 900;
}

.drink-en,
.drink-abv {
  margin-top: 6rpx;
  color: #7f8794;
  font-size: 22rpx;
}

.form {
  padding: 28rpx;
}

.label {
  margin-top: 26rpx;
  color: #111318;
  font-size: 24rpx;
  font-weight: 900;
}

.label:first-child {
  margin-top: 0;
}

.stars {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.star {
  color: #e5e9f0;
  font-size: 46rpx;
}

.star.active {
  color: #ffbd2e;
}

.scene-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 20rpx;
}

.pill {
  background: #f6f7fa;
  color: #606a78;
}

.pill.active {
  background: linear-gradient(135deg, #ff9f45, #ff4f7b);
  color: #ffffff;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 18rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8f9fc;
  color: #606a78;
  font-size: 24rpx;
  line-height: 1.5;
}

.delete-button {
  height: 78rpx;
  margin-top: 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: #fff0f2;
  color: #ff4f62;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
}
