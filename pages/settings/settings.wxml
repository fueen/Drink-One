<view class="page settings-page">
  <view class="top-bar">
    <text class="nav-back" bindtap="goBack">‹</text>
    <text class="top-title">设置</text>
    <text class="nav-action"></text>
  </view>
  <text class="sr-only">消息通知 隐私设置 清除缓存 意见反馈 关于我们 退出登录</text>
  <view class="settings-list">
    <view class="setting-row" wx:for="{{settings}}" wx:key="name" data-name="{{item.name}}" bindtap="tapSetting">
      <view class="setting-left">
        <text class="setting-icon">{{item.icon}}</text>
        <text class="setting-name">{{item.name}}</text>
      </view>
      <view class="setting-right">
        <text class="setting-value">{{item.name === '清除缓存' ? cacheSize : item.value}}</text>
        <text class="chevron">›</text>
      </view>
    </view>
  </view>
  <button class="logout-button" bindtap="logout">退出登录</button>
</view>
