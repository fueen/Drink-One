.settings-page {
  padding-bottom: 164rpx;
  background:
    radial-gradient(circle at 20% 8%, rgba(122, 115, 255, 0.12), transparent 32%),
    linear-gradient(180deg, #fbfcff 0%, #f7f8fc 100%);
}

.settings-list {
  margin-top: 36rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 20rpx 58rpx rgba(87, 98, 128, 0.08);
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-left,
.setting-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: rgba(122, 115, 255, 0.1);
  color: #7A73FF;
  font-size: 24rpx;
}

.setting-name {
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 800;
}

.setting-value,
.chevron {
  color: #9CA3AF;
  font-size: 22rpx;
}

.logout-button {
  position: fixed;
  left: 46rpx;
  right: 46rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  height: 82rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #1C1C1E;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 82rpx;
  box-shadow: 0 18rpx 48rpx rgba(87, 98, 128, 0.08);
}
