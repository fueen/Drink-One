.settings-page {
  padding-bottom: 150rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.settings-list {
  margin-top: 34rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(39, 48, 69, 0.06);
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #f0f2f6;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-left,
.setting-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #fff1e6;
  color: #ff8a42;
  font-size: 23rpx;
}

.setting-name {
  color: #111318;
  font-size: 25rpx;
  font-weight: 800;
}

.setting-value,
.chevron {
  color: #9aa2af;
  font-size: 22rpx;
}

.logout-button {
  position: fixed;
  left: 42rpx;
  right: 42rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  height: 80rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111318;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 80rpx;
  box-shadow: 0 12rpx 32rpx rgba(39, 48, 69, 0.08);
}
