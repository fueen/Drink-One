<view class="page test-page">
  <view class="between">
    <view>
      <text class="page-title">酒量测试</text>
      <text class="page-subtitle">填写信息，看看你的酒量等级</text>
    </view>
    <text class="hero-mark">◒</text>
  </view>
  <view class="form-card card">
    <view class="form-row" wx:for="{{fields}}" wx:key="label">
      <text>{{item.label}}</text>
      <text class="value">{{item.value}} ›</text>
    </view>
  </view>
  <view class="primary-button">开始测试</view>
  <text class="hint">测试结果仅供参考</text>
</view>
