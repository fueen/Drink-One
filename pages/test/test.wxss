.test-page {
  padding-bottom: 150rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
}

.history-link {
  color: #5f6876;
  font-size: 22rpx;
}

.test-intro {
  margin-top: 38rpx;
}

.test-title,
.test-subtitle,
.form-label {
  display: block;
}

.test-title {
  color: #111318;
  font-size: 32rpx;
  font-weight: 900;
}

.test-subtitle {
  margin-top: 10rpx;
  color: #8d95a3;
  font-size: 22rpx;
}

.form-panel {
  margin-top: 32rpx;
}

.form-row {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  align-items: center;
  gap: 20rpx;
  min-height: 84rpx;
}

.form-label {
  color: #111318;
  font-size: 24rpx;
  font-weight: 800;
}

.segmented-control {
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 58rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f6f7fa;
}

.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #111318;
  font-size: 23rpx;
}

.segment.active {
  background: linear-gradient(135deg, #ff9f45, #ff4f7b);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(255, 79, 123, 0.2);
}

.input-like {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(39, 48, 69, 0.05);
  color: #111318;
  font-size: 23rpx;
}

.unit {
  color: #9aa2af;
  font-size: 20rpx;
}
